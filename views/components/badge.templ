package components

import "strings"

type StatusType string

const (
	StatusActive    StatusType = "active"
	StatusStopped   StatusType = "stopped"
	StatusDeploying StatusType = "deploying"
)

templ ServerStatusBadge(status string) {
	switch strings.ToLower(status) {
		case "active", "running":
			<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shadow-sm">
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
				</span>
				Active
			</span>
		case "deploying", "restarting":
			<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20 shadow-sm">
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
				</span>
				Deploying
			</span>
		case "stopped":
			<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20 shadow-sm">
				<span class="h-2 w-2 rounded-full bg-rose-500"></span>
				Stopped
			</span>
		default:
			<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-zinc-800 text-zinc-400 border border-zinc-700">
				<span class="h-2 w-2 rounded-full bg-zinc-500"></span>
				{ status }
			</span>
	}
}

templ GenericBadge(text string, variant string) {
	if variant == "info" {
		<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-sky-500/10 text-sky-400 border border-sky-500/20">
			{ text }
		</span>
	} else if variant == "purple" {
		<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-violet-500/10 text-violet-400 border border-violet-500/20">
			{ text }
		</span>
	} else {
		<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-zinc-800/80 text-zinc-300 border border-zinc-700/60 font-mono">
			{ text }
		</span>
	}
}
