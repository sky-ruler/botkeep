package components

type ButtonVariant string

const (
	BtnPrimary   ButtonVariant = "primary"
	BtnSecondary ButtonVariant = "secondary"
	BtnDanger    ButtonVariant = "danger"
	BtnGhost     ButtonVariant = "ghost"
)

type ButtonSize string

const (
	BtnSizeSm ButtonSize = "sm"
	BtnSizeMd ButtonSize = "md"
	BtnSizeLg ButtonSize = "lg"
)

type ButtonProps struct {
	Text        string
	Variant     ButtonVariant
	Size        ButtonSize
	Type        string
	Class       string
	HXPost      string
	HXTarget    string
	HXSwap      string
	HXIndicator string
	Disabled    bool
}

func getButtonClasses(variant ButtonVariant, size ButtonSize, extraClass string) string {
	base := "inline-flex items-center justify-center font-medium transition-all duration-150 rounded-md focus:outline-none focus:ring-2 focus:ring-zinc-400 focus:ring-offset-2 focus:ring-offset-zinc-950 disabled:opacity-50 disabled:pointer-events-none cursor-pointer "
	
	sizeClass := "px-3 py-1.5 text-xs gap-1.5 "
	if size == BtnSizeMd {
		sizeClass = "px-4 py-2 text-sm gap-2 "
	} else if size == BtnSizeLg {
		sizeClass = "px-5 py-2.5 text-base gap-2.5 "
	}

	var variantClass string
	switch variant {
	case BtnPrimary:
		// Linear/Vercel standard: Crisp solid white on dark with subtle hover elevation
		variantClass = "bg-zinc-100 text-zinc-950 hover:bg-white active:bg-zinc-200 shadow-sm border border-transparent "
	case BtnDanger:
		variantClass = "bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 active:bg-rose-500/30 "
	case BtnGhost:
		variantClass = "text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 "
	default: // BtnSecondary
		variantClass = "bg-zinc-900/60 text-zinc-200 border border-zinc-800 hover:bg-zinc-800 hover:border-zinc-700 active:bg-zinc-800/80 shadow-sm "
	}

	return base + sizeClass + variantClass + extraClass
}

templ Button(props ButtonProps) {
	<button
		if props.Type != "" {
			type={ props.Type }
		} else {
			type="button"
		}
		class={ getButtonClasses(props.Variant, props.Size, props.Class) }
		if props.HXPost != "" {
			hx-post={ props.HXPost }
		}
		if props.HXTarget != "" {
			hx-target={ props.HXTarget }
		}
		if props.HXSwap != "" {
			hx-swap={ props.HXSwap }
		}
		if props.HXIndicator != "" {
			hx-indicator={ props.HXIndicator }
		}
		if props.HXPost != "" {
			hx-disabled-elt="this"
		}
		if props.Disabled {
			disabled
		}
	>
		{ children... }
		<span>{ props.Text }</span>
	</button>
}

// Specialized Server Action Buttons with built-in spinner indicators
templ ActionButton(action string, serverID string, disabled bool) {
	switch action {
		case "start":
			<button
				type="button"
				hx-post={ "/servers/" + serverID + "/start" }
				hx-target={ "#server-row-" + serverID }
				hx-swap="outerHTML"
				hx-indicator={ "#indicator-" + serverID }
				hx-disabled-elt="this"
				if disabled {
					disabled
				}
				class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20 active:bg-emerald-500/30 transition-colors disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
				title="Start server"
			>
				@IconPlay("w-3 h-3")
				<span>Start</span>
			</button>
		case "stop":
			<button
				type="button"
				hx-post={ "/servers/" + serverID + "/stop" }
				hx-target={ "#server-row-" + serverID }
				hx-swap="outerHTML"
				hx-indicator={ "#indicator-" + serverID }
				hx-disabled-elt="this"
				if disabled {
					disabled
				}
				class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 active:bg-rose-500/30 transition-colors disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
				title="Stop server"
			>
				@IconSquare("w-3 h-3")
				<span>Stop</span>
			</button>
		case "restart":
			<button
				type="button"
				hx-post={ "/servers/" + serverID + "/restart" }
				hx-target={ "#server-row-" + serverID }
				hx-swap="outerHTML"
				hx-indicator={ "#indicator-" + serverID }
				hx-disabled-elt="this"
				if disabled {
					disabled
				}
				class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-zinc-800 text-zinc-300 border border-zinc-700 hover:bg-zinc-700/80 hover:text-zinc-100 transition-colors disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
				title="Restart server"
			>
				@IconRotateCw("w-3 h-3")
				<span>Restart</span>
			</button>
	}
}
