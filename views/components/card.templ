package components

import "fmt"

templ Card(title string, subtitle string, extraClass string) {
	<div class={ "bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-5 shadow-sm transition-all duration-200 hover:border-zinc-700/60 " + extraClass }>
		if title != "" || subtitle != "" {
			<div class="flex items-center justify-between mb-4">
				<div>
					if title != "" {
						<h3 class="text-sm font-semibold text-zinc-100 tracking-tight">{ title }</h3>
					}
					if subtitle != "" {
						<p class="text-xs text-zinc-400 mt-0.5">{ subtitle }</p>
					}
				</div>
			</div>
		}
		{ children... }
	</div>
}

type MetricProps struct {
	Title       string
	Value       string
	Subtext     string
	Percentage  int
	Trend       string
	TrendUp     bool
	Warning     bool
	Critical    bool
}

templ MetricCard(props MetricProps, icon templ.Component) {
	<div class="relative overflow-hidden bg-zinc-900/70 border border-zinc-800 rounded-xl p-5 shadow-sm hover:border-zinc-700/80 transition-all duration-200 group">
		<!-- Subtle ambient glow on hover -->
		<div class="absolute -top-12 -right-12 w-24 h-24 bg-zinc-700/10 rounded-full blur-xl group-hover:bg-zinc-500/10 transition-colors pointer-events-none"></div>

		<div class="flex items-center justify-between">
			<span class="text-xs font-medium uppercase tracking-wider text-zinc-400">{ props.Title }</span>
			<div class="p-2 rounded-lg bg-zinc-800/60 border border-zinc-700/40 text-zinc-300">
				@icon
			</div>
		</div>

		<div class="mt-4 flex items-baseline justify-between">
			<span class="text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-100 font-mono">{ props.Value }</span>
			if props.Trend != "" {
				<span class={ "text-xs font-medium flex items-center gap-0.5 ",
					templ.KV("text-emerald-400", !props.Critical && !props.Warning && props.TrendUp),
					templ.KV("text-zinc-400", !props.Critical && !props.Warning && !props.TrendUp),
					templ.KV("text-rose-400", props.Critical),
					templ.KV("text-amber-400", props.Warning && !props.Critical),
				}>
					{ props.Trend }
				</span>
			}
		</div>

		<!-- Progress track -->
		if props.Percentage > 0 {
			<div class="mt-3.5">
				<div class="w-full bg-zinc-800/80 rounded-full h-1.5 overflow-hidden">
					<div
						class={ "h-1.5 rounded-full transition-all duration-500 ",
							templ.KV("bg-emerald-500", !props.Warning && !props.Critical),
							templ.KV("bg-amber-500", props.Warning && !props.Critical),
							templ.KV("bg-rose-500", props.Critical),
						}
						style={ fmt.Sprintf("width: %d%%", props.Percentage) }
					></div>
				</div>
				<div class="mt-2 flex items-center justify-between text-[11px] text-zinc-500">
					<span>{ props.Subtext }</span>
					<span class="font-mono">{ fmt.Sprintf("%d%%", props.Percentage) }</span>
				</div>
			</div>
		} else {
			<p class="mt-2 text-xs text-zinc-400">{ props.Subtext }</p>
		}
	</div>
}
