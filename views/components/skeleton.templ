package components

templ Skeleton(class string) {
	<div class={ "animate-pulse bg-zinc-800/60 rounded " + class }></div>
}

templ MetricSkeleton() {
	<div class="bg-zinc-900/40 border border-zinc-800/60 rounded-xl p-5 shadow-sm">
		<div class="flex items-center justify-between">
			<div class="h-3 w-20 bg-zinc-800 rounded animate-pulse"></div>
			<div class="h-8 w-8 bg-zinc-800/80 rounded-lg animate-pulse"></div>
		</div>
		<div class="mt-4 flex items-baseline justify-between">
			<div class="h-8 w-28 bg-zinc-800 rounded animate-pulse"></div>
			<div class="h-3 w-12 bg-zinc-800/60 rounded animate-pulse"></div>
		</div>
		<div class="mt-4 h-1.5 w-full bg-zinc-800/60 rounded-full animate-pulse"></div>
		<div class="mt-2 flex justify-between">
			<div class="h-2.5 w-24 bg-zinc-800/40 rounded animate-pulse"></div>
			<div class="h-2.5 w-8 bg-zinc-800/40 rounded animate-pulse"></div>
		</div>
	</div>
}

templ TableRowSkeleton() {
	<tr class="animate-pulse border-b border-zinc-800/60">
		<td class="py-3.5 pl-4 pr-3">
			<div class="flex items-center gap-3">
				<div class="h-8 w-8 rounded-lg bg-zinc-800"></div>
				<div class="space-y-1.5">
					<div class="h-3.5 w-28 bg-zinc-800 rounded"></div>
					<div class="h-2.5 w-16 bg-zinc-800/60 rounded"></div>
				</div>
			</div>
		</td>
		<td class="px-3 py-3.5">
			<div class="h-4 w-16 bg-zinc-800 rounded-full"></div>
		</td>
		<td class="px-3 py-3.5">
			<div class="h-3 w-20 bg-zinc-800 rounded"></div>
		</td>
		<td class="px-3 py-3.5">
			<div class="h-3 w-14 bg-zinc-800 rounded"></div>
		</td>
		<td class="px-3 py-3.5">
			<div class="h-3 w-12 bg-zinc-800 rounded"></div>
		</td>
		<td class="py-3.5 pl-3 pr-4 text-right">
			<div class="inline-flex gap-2">
				<div class="h-6 w-14 bg-zinc-800 rounded"></div>
				<div class="h-6 w-14 bg-zinc-800 rounded"></div>
			</div>
		</td>
	</tr>
}
