package pages

import (
	"fmt"
	"botkeep/internal/models"
	"botkeep/views/components"
	"botkeep/views/layouts"
)

templ Dashboard(servers []models.Server, metrics *models.ClusterMetrics, logs []models.LogEntry) {
	@layouts.Base("DevOps Fleet Dashboard") {
		<!-- Drawer Container for Node Inspection -->
		<div id="drawer-container"></div>

		<!-- Top Action Bar & Header -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-zinc-800/60">
			<div>
				<h1 class="text-lg sm:text-xl font-semibold tracking-tight text-zinc-100">Fleet Telemetry & Production Observability</h1>
				<p class="text-xs text-zinc-400 mt-1">Real-time edge compute monitoring, multi-protocol health checks, and rolling SLA compliance.</p>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<!-- Satellite Mesh Consensus Badge -->
				<div class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-zinc-900/90 border border-zinc-800 text-xs font-mono shadow-sm" title="Multi-Region Satellite Consensus Probing active across edge nodes">
					<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
					<span class="text-zinc-400">Mesh:</span>
					<span class="text-emerald-400 font-semibold">3 Edge Regions</span>
				</div>

				<!-- Poll Metrics Button -->
				<button
					type="button"
					hx-get="/metrics"
					hx-target="#metrics-grid"
					hx-swap="innerHTML"
					hx-indicator="#global-indicator"
					hx-disabled-elt="this"
					class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-zinc-900 text-zinc-300 border border-zinc-800 hover:bg-zinc-800 hover:text-zinc-100 transition-colors cursor-pointer shadow-sm"
					title="Refresh cluster metrics"
				>
					@components.IconRefresh("w-3.5 h-3.5")
					<span>Poll Metrics</span>
				</button>

				<!-- GitOps Export YAML Button -->
				<a
					href="/api/fleet/gitops/export"
					download="fleet.yaml"
					class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-zinc-900 text-zinc-300 border border-zinc-800 hover:bg-zinc-800 hover:text-zinc-100 transition-colors shadow-sm cursor-pointer"
					title="Export declarative GitOps fleet.yaml"
				>
					<svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="16" y1="13" x2="8" y2="13"></line>
						<line x1="16" y1="17" x2="8" y2="17"></line>
					</svg>
					<span>GitOps YAML</span>
				</a>

				<!-- Quick Deploy Focus Button -->
				<button
					type="button"
					onclick="document.getElementById('deploy-name-input').focus()"
					class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-zinc-100 text-zinc-950 hover:bg-white active:bg-zinc-200 transition-colors shadow-sm cursor-pointer"
					title="Add new monitoring target"
				>
					@components.IconPlus("w-3.5 h-3.5")
					<span>Add Monitor</span>
				</button>
			</div>
		</div>

		<!-- Section 1: Dashboard Overview Grid (Auto-polled by HTMX every 5s) -->
		<div
			id="metrics-grid"
			hx-get="/metrics"
			hx-trigger="every 5s"
			hx-swap="innerHTML"
		>
			@MetricsGrid(metrics)
		</div>

		<!-- Section 2: Server Fleet Table & Node Provisioning -->
		<div class="space-y-4">
			<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
				<!-- Search and Status Filtering Form -->
				<form
					id="filter-form"
					hx-get="/servers"
					hx-target="#server-table-container"
					hx-swap="innerHTML"
					hx-trigger="submit, keyup changed delay:250ms from:#search-input, change from:#filter-status, change from:#filter-region"
					class="flex flex-wrap items-center gap-2 flex-1"
				>
					<div class="relative w-full sm:w-64">
						<input
							type="text"
							id="search-input"
							name="q"
							placeholder="Search targets by name, ID, IP..."
							class="w-full pl-8 pr-3 py-1.5 bg-zinc-900 border border-zinc-800 rounded-md text-xs text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 font-sans"
						/>
						<div class="absolute left-2.5 top-2 text-zinc-500 pointer-events-none">
							<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="11" cy="11" r="8"></circle>
								<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
							</svg>
						</div>
					</div>

					<select
						id="filter-status"
						name="status"
						class="w-full sm:w-auto px-2.5 py-1.5 bg-zinc-900 border border-zinc-800 rounded-md text-xs text-zinc-300 focus:outline-none focus:border-zinc-600 font-sans cursor-pointer"
					>
						<option value="all">All Statuses</option>
						<option value="active">Active</option>
						<option value="stopped">Stopped</option>
						<option value="deploying">Deploying</option>
					</select>

					<select
						id="filter-region"
						name="region"
						class="w-full sm:w-auto px-2.5 py-1.5 bg-zinc-900 border border-zinc-800 rounded-md text-xs text-zinc-300 focus:outline-none focus:border-zinc-600 font-sans cursor-pointer"
					>
						<option value="all">All Regions</option>
						<option value="us-east-1">us-east-1</option>
						<option value="eu-central-1">eu-central-1</option>
						<option value="ap-southeast-1">ap-southeast-1</option>
					</select>
				</form>

				<!-- Quick Deploy Node Inline Bar -->
				<form
					hx-post="/servers/new"
					hx-target="#server-table-container"
					hx-swap="innerHTML"
					hx-indicator="#deploy-indicator"
					hx-on::after-request="if(event.detail.successful) this.reset()"
					class="flex flex-wrap items-center gap-2 w-full lg:w-auto"
				>
					<input
						type="text"
						id="deploy-name-input"
						name="name"
						placeholder="Target name (e.g. prod-api)"
						required
						class="w-full sm:w-36 md:w-44 px-3 py-1.5 bg-zinc-900 border border-zinc-800 rounded-md text-xs text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 font-sans"
					/>
					<select
						name="driver"
						class="w-full sm:w-auto px-2 py-1.5 bg-zinc-900 border border-zinc-800 rounded-md text-xs text-zinc-300 focus:outline-none focus:border-zinc-600 font-sans cursor-pointer"
					>
						<option value="http">HTTP / HTTPS</option>
						<option value="grpc">gRPC Health Check</option>
						<option value="dns">DNS Resolution</option>
						<option value="tcp">TCP Socket / DB</option>
						<option value="demo">Simulated Node</option>
					</select>
					<input
						type="text"
						name="endpoint_url"
						placeholder="Target (e.g. https://api.github.com or host:5432)"
						class="w-full sm:w-56 md:w-64 px-3 py-1.5 bg-zinc-900 border border-zinc-800 rounded-md text-xs text-zinc-200 placeholder-zinc-500 focus:outline-none focus:border-zinc-600 font-sans font-mono"
					/>
					<select
						name="region"
						class="w-full sm:w-auto px-2 py-1.5 bg-zinc-900 border border-zinc-800 rounded-md text-xs text-zinc-300 focus:outline-none focus:border-zinc-600 font-sans cursor-pointer"
					>
						<option value="us-east-1">us-east-1</option>
						<option value="eu-central-1">eu-central-1</option>
						<option value="ap-southeast-1">ap-southeast-1</option>
					</select>
					<button
						type="submit"
						class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-zinc-100 text-zinc-950 hover:bg-white active:bg-zinc-200 transition-colors shadow-sm cursor-pointer whitespace-nowrap"
					>
						<span id="deploy-indicator" class="htmx-indicator">
							@components.IconSpinner("w-3 h-3 text-zinc-900")
						</span>
						@components.IconPlus("w-3.5 h-3.5")
						<span>Deploy</span>
					</button>
				</form>
			</div>

			<!-- Dynamic Server Table Container -->
			<div id="server-table-container">
				@ServerTable(servers)
			</div>
		</div>

		<!-- Section 3: Live Telemetry Logs Terminal Panel (Auto-polled by HTMX every 4s) -->
		<div class="space-y-4">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-2">
					<h2 class="text-sm font-semibold tracking-tight text-zinc-100">Live Orchestration Logs</h2>
					<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-800/80 text-emerald-400 border border-zinc-700">
						<span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
						Streaming
					</span>
				</div>
				<button
					type="button"
					hx-post="/logs/clear"
					hx-target="#logs-stream"
					hx-swap="innerHTML"
					class="text-xs text-zinc-400 hover:text-zinc-200 transition-colors cursor-pointer"
				>
					Clear Buffer
				</button>
			</div>

			<!-- Terminal Window Frame -->
			<div class="bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden shadow-2xl">
				<!-- Terminal Window Title Bar -->
				<div class="h-9 px-4 bg-zinc-900/80 border-b border-zinc-800/80 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="flex gap-1.5">
							<span class="w-2.5 h-2.5 rounded-full bg-zinc-700/80"></span>
							<span class="w-2.5 h-2.5 rounded-full bg-zinc-700/80"></span>
							<span class="w-2.5 h-2.5 rounded-full bg-zinc-700/80"></span>
						</div>
						<span class="ml-2 font-mono text-[11px] text-zinc-400">telemetry-agent@botkeep-edge:~$ journalctl -u cluster-orchestrator -f</span>
					</div>
					<div class="flex items-center gap-2">
						<span class="text-[10px] font-mono text-zinc-500">buffer: 20 lines</span>
					</div>
				</div>

				<!-- Terminal Body -->
				<div
					id="logs-stream"
					hx-get="/logs"
					hx-trigger="every 4s"
					hx-swap="innerHTML"
					class="p-4 font-mono text-xs leading-relaxed max-h-72 overflow-y-auto space-y-1.5 bg-canvas select-text"
				>
					@LogsStream(logs)
				</div>
			</div>
		</div>
	}
}

templ MetricsGrid(metrics *models.ClusterMetrics) {
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
		<!-- Card 1: Active Fleet Capacity -->
		@components.MetricCard(components.MetricProps{
			Title:      "Fleet Capacity",
			Value:      fmt.Sprintf("%d / %d", metrics.ActiveCount, metrics.TotalCount),
			Subtext:    fmt.Sprintf("%d active • %d stopped", metrics.ActiveCount, metrics.StoppedCount),
			Percentage: int(float64(metrics.ActiveCount) / float64(max(metrics.TotalCount, 1)) * 100.0),
			Trend:      "Targets",
			TrendUp:    true,
		}, components.IconServer("w-4 h-4 text-zinc-300"))

		<!-- Card 2: Average Probe Latency -->
		@components.MetricCard(components.MetricProps{
			Title:      "Avg Probe Latency",
			Value:      fmt.Sprintf("%.1fms", metrics.AvgLatencyMS),
			Subtext:    "Network roundtrip response",
			Percentage: min(int((metrics.AvgLatencyMS/200.0)*100.0), 100),
			Trend:      "Realtime",
			TrendUp:    metrics.AvgLatencyMS < 80.0,
			Warning:    metrics.AvgLatencyMS >= 120.0,
			Critical:   metrics.AvgLatencyMS >= 300.0,
		}, components.IconActivity("w-4 h-4 text-zinc-300"))

		<!-- Card 3: Fleet Health SLA -->
		@components.MetricCard(components.MetricProps{
			Title:      "Fleet Health SLA",
			Value:      fmt.Sprintf("%.1f%%", metrics.AvgSLA),
			Subtext:    fmt.Sprintf("Audited across %d fleet nodes", metrics.TotalCount),
			Percentage: int(metrics.AvgSLA),
			Trend:      "SLA Window",
			TrendUp:    metrics.AvgSLA >= 99.0,
			Warning:    metrics.AvgSLA < 99.0 && metrics.AvgSLA >= 90.0,
			Critical:   metrics.AvgSLA < 90.0,
		}, components.IconCheckCircle("w-4 h-4 text-zinc-300"))

		<!-- Card 4: Real Host Go Runtime Memory -->
		@components.MetricCard(components.MetricProps{
			Title:      "Engine Heap Memory",
			Value:      fmt.Sprintf("%.1f MB", metrics.Host.AllocatedMB),
			Subtext:    fmt.Sprintf("%d goroutines • %d GC cycles", metrics.Host.NumGoroutine, metrics.Host.NumGC),
			Percentage: min(int((metrics.Host.AllocatedMB/64.0)*100.0), 100),
			Trend:      metrics.Host.GoVersion,
			TrendUp:    true,
		}, components.IconCpu("w-4 h-4 text-zinc-300"))
	</div>
}

templ ServerTable(servers []models.Server) {
	if len(servers) == 0 {
		@components.EmptyState(
			"No server instances active",
			"You do not have any registered nodes matching your query. Seed demo servers or provision an edge instance.",
			"Deploy Demo Fleet",
			"/servers/seed",
		)
	} else {
		<div class="overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900/40 shadow-sm">
			<table class="min-w-full divide-y divide-zinc-800 text-left text-xs">
				<thead>
					<tr class="bg-zinc-900/80 text-zinc-400 font-medium">
						<th scope="col" class="py-3 pl-4 pr-3">Node / Target</th>
						<th scope="col" class="px-3 py-3">Driver & Protocol</th>
						<th scope="col" class="px-3 py-3">Status</th>
						<th scope="col" class="px-3 py-3">Latency & SLA</th>
						<th scope="col" class="px-3 py-3">Resources</th>
						<th scope="col" class="px-3 py-3">Region & Age</th>
						<th scope="col" class="py-3 pl-3 pr-4 text-right">Actions</th>
					</tr>
				</thead>
				<tbody id="server-table-body" class="divide-y divide-zinc-800/60 font-mono">
					for _, s := range servers {
						@ServerRow(s)
					}
				</tbody>
			</table>
		</div>
	}
}

templ ServerRow(s models.Server) {
	<tr id={ "server-row-" + s.ID } class="hover:bg-zinc-800/30 transition-colors group">
		<!-- Name & ID (Clickable to open inspector drawer) -->
		<td class="py-3.5 pl-4 pr-3 font-sans">
			<div class="flex items-center gap-3">
				<div class="w-8 h-8 rounded-lg bg-zinc-800/80 border border-zinc-700/60 flex items-center justify-center text-zinc-300 group-hover:border-zinc-500 transition-colors flex-shrink-0">
					if s.Driver == "tcp" {
						@components.IconDatabase("w-4 h-4 text-amber-400")
					} else if s.Driver == "http" {
						@components.IconGlobe("w-4 h-4 text-cyan-400")
					} else {
						@components.IconServer("w-4 h-4")
					}
				</div>
				<div>
					<button
						type="button"
						hx-get={ "/servers/" + s.ID + "/details" }
						hx-target="#drawer-container"
						hx-swap="innerHTML"
						class="font-medium text-zinc-100 hover:text-white flex items-center gap-2 cursor-pointer text-left focus:outline-none"
						title="Inspect node telemetry"
					>
						<span>{ s.Name }</span>
						<span id={ "indicator-" + s.ID } class="htmx-indicator items-center">
							@components.IconSpinner("w-3.5 h-3.5 text-zinc-400")
						</span>
					</button>
					<div class="flex items-center gap-2 text-[11px] text-zinc-500 font-mono">
						<span>{ s.ID }</span>
						if s.EndpointURL != "" {
							<span class="text-zinc-600">•</span>
							<span class="text-cyan-400/80 truncate max-w-[140px] sm:max-w-[200px]" title={ s.EndpointURL }>{ s.EndpointURL }</span>
						}
					</div>
				</div>
			</div>
		</td>

		<!-- Driver Type & Protocol & SSL Badges -->
		<td class="px-3 py-3.5 font-sans">
			<div class="flex flex-wrap items-center gap-1.5">
				@components.DriverBadge(s.Driver)
				@components.ProtocolBadge(s.Protocol)
				if s.SSLExpiryDays >= 0 {
					@components.SSLBadge(s.SSLExpiryDays)
				}
				if s.RunbookEnabled {
					<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title="Self-Healing Runbook Active">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
						Auto-Heal
					</span>
				}
			</div>
		</td>

		<!-- Status Badge -->
		<td class="px-3 py-3.5 font-sans">
			@components.ServerStatusBadge(s.Status)
		</td>

		<!-- Latency & SLA Sparkline -->
		<td class="px-3 py-3.5 font-sans">
			<div class="space-y-1">
				<div class="flex items-center gap-1.5 font-mono">
					if s.Status == "stopped" {
						<span class="text-zinc-600 text-xs">—</span>
					} else {
						<span class="text-xs text-zinc-200">{ fmt.Sprintf("%.1fms", s.LatencyMS) }</span>
						<span class={ "text-[10px] px-1 py-0.2 rounded ",
							templ.KV("text-emerald-400 bg-emerald-500/10", s.UptimePct >= 99.0),
							templ.KV("text-amber-400 bg-amber-500/10", s.UptimePct >= 90.0 && s.UptimePct < 99.0),
							templ.KV("text-rose-400 bg-rose-500/10", s.UptimePct < 90.0),
						}>
							{ fmt.Sprintf("%.1f%%", s.UptimePct) }
						</span>
					}
				</div>
				<!-- Spark dots -->
				if len(s.ProbePoints) > 0 {
					<div class="flex items-center gap-1" title="Recent health check results">
						for _, pt := range s.ProbePoints {
							if pt.Success {
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-400/80" title={ fmt.Sprintf("%.1fms", pt.LatencyMS) }></span>
							} else {
								<span class="w-1.5 h-1.5 rounded-full bg-rose-500" title={ fmt.Sprintf("Error HTTP %d", pt.StatusCode) }></span>
							}
						}
					</div>
				}
			</div>
		</td>

		<!-- Resources (CPU / RAM) -->
		<td class="px-3 py-3.5 font-sans">
			if s.Status == "stopped" {
				<span class="text-zinc-600 font-mono text-xs">Offline</span>
			} else {
				<div class="space-y-1">
					<div class="flex items-center gap-1.5 text-[11px] font-mono">
						<span class="text-zinc-500 w-7">CPU</span>
						<div class="w-12 bg-zinc-800 rounded-full h-1 overflow-hidden">
							<div class="bg-zinc-300 h-1 rounded-full" style={ fmt.Sprintf("width: %d%%", int(s.CPUUsage)) }></div>
						</div>
						<span class="text-zinc-300">{ fmt.Sprintf("%.0f%%", s.CPUUsage) }</span>
					</div>
					<div class="flex items-center gap-1.5 text-[11px] font-mono">
						<span class="text-zinc-500 w-7">RAM</span>
						<div class="w-12 bg-zinc-800 rounded-full h-1 overflow-hidden">
							<div class="bg-zinc-400 h-1 rounded-full" style={ fmt.Sprintf("width: %d%%", int(s.MemoryUsage)) }></div>
						</div>
						<span class="text-zinc-300">{ fmt.Sprintf("%.0f%%", s.MemoryUsage) }</span>
					</div>
				</div>
			}
		</td>

		<!-- Region / Uptime -->
		<td class="px-3 py-3.5 text-[11px]">
			<div class="text-zinc-300 font-mono">{ s.Region }</div>
			<div class="text-zinc-500">{ s.Uptime }</div>
		</td>

		<!-- Action Triggers -->
		<td class="py-3.5 pl-3 pr-4 text-right font-sans">
			<div class="inline-flex items-center gap-1.5">
				<!-- Ping Now button -->
				<button
					type="button"
					hx-post={ "/servers/" + s.ID + "/ping" }
					hx-target={ "#server-row-" + s.ID }
					hx-swap="outerHTML"
					hx-indicator={ "#ping-spin-" + s.ID }
					class="inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-800 transition-colors cursor-pointer"
					title="Trigger live probe check"
				>
					<span id={ "ping-spin-" + s.ID } class="htmx-indicator">
						@components.IconSpinner("w-3 h-3 text-cyan-400")
					</span>
					@components.IconActivity("w-3 h-3 text-cyan-400")
					<span>Ping</span>
				</button>

				if s.Status == "stopped" {
					@components.ActionButton("start", s.ID, false)
				} else {
					@components.ActionButton("stop", s.ID, false)
					@components.ActionButton("restart", s.ID, false)
				}

				<!-- Inspect Drawer Trigger -->
				<button
					type="button"
					hx-get={ "/servers/" + s.ID + "/details" }
					hx-target="#drawer-container"
					hx-swap="innerHTML"
					class="p-1 rounded text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800 transition-colors cursor-pointer"
					title="Inspect details"
				>
					<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="1"></circle>
						<circle cx="19" cy="12" r="1"></circle>
						<circle cx="5" cy="12" r="1"></circle>
					</svg>
				</button>
			</div>
		</td>
	</tr>
}

templ LogsStream(logs []models.LogEntry) {
	if len(logs) == 0 {
		<div class="text-zinc-500 py-6 text-center">No recent telemetry events recorded in buffer.</div>
	} else {
		for _, l := range logs {
			<div class="flex items-start gap-3 hover:bg-zinc-900/60 px-2 py-0.5 rounded transition-colors">
				<span class="text-zinc-500 flex-shrink-0 text-[11px]">{ l.CreatedAt.Format("15:04:05.000") }</span>
				switch l.Level {
					case "INFO":
						<span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20 flex-shrink-0">INFO</span>
					case "WARN":
						<span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 flex-shrink-0">WARN</span>
					case "ERROR":
						<span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20 flex-shrink-0">ERROR</span>
					case "DEPLOY":
						<span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex-shrink-0">DEPLOY</span>
					default:
						<span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-zinc-800 text-zinc-400 flex-shrink-0">{ l.Level }</span>
				}
				<span class="text-zinc-300 break-all">{ l.Message }</span>
			</div>
		}
	}
}
