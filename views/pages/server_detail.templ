package pages

import (
	"fmt"
	"botkeep/internal/models"
	"botkeep/views/components"
)

templ ServerDetailDrawer(s models.Server, logs []models.LogEntry) {
	<div id="detail-drawer" class="fixed inset-0 z-50 overflow-hidden bg-zinc-950/70 backdrop-blur-sm flex justify-end transition-opacity duration-300">
		<!-- Backdrop click to close -->
		<div class="fixed inset-0" onclick="document.getElementById('detail-drawer').remove()"></div>

		<!-- Slide-over panel -->
		<div class="relative w-full sm:max-w-md md:max-w-lg bg-zinc-900 border-l border-zinc-800 shadow-2xl flex flex-col h-full z-10 overflow-y-auto">
			<!-- Header -->
			<div class="p-5 sm:p-6 border-b border-zinc-800 flex items-start justify-between bg-zinc-900/90 sticky top-0 z-20 backdrop-blur-md">
				<div class="flex items-center gap-3">
					<div class="w-10 h-10 rounded-xl bg-zinc-800 border border-zinc-700/80 flex items-center justify-center text-zinc-200 flex-shrink-0">
						if s.Driver == "tcp" {
							@components.IconDatabase("w-5 h-5 text-amber-400")
						} else if s.Driver == "http" {
							@components.IconGlobe("w-5 h-5 text-cyan-400")
						} else {
							@components.IconServer("w-5 h-5")
						}
					</div>
					<div>
						<div class="flex flex-wrap items-center gap-2">
							<h3 class="text-base font-semibold text-zinc-100 tracking-tight">{ s.Name }</h3>
							@components.ServerStatusBadge(s.Status)
						</div>
						<p class="text-xs text-zinc-500 font-mono mt-0.5">{ s.ID } • { s.IPAddress } • { s.Region }</p>
					</div>
				</div>

				<button
					type="button"
					onclick="document.getElementById('detail-drawer').remove()"
					class="p-1.5 text-zinc-400 hover:text-zinc-100 rounded-md hover:bg-zinc-800 transition-colors cursor-pointer"
					title="Close inspector"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>

			<!-- Body -->
			<div class="p-5 sm:p-6 space-y-6 flex-1">
				<!-- Action Triggers inside Drawer -->
				<div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-lg bg-zinc-950/60 border border-zinc-800">
					<span class="text-xs font-medium text-zinc-400">Node State Actions</span>
					<div class="flex flex-wrap items-center gap-2">
						if s.Status == "stopped" {
							@components.ActionButton("start", s.ID, false)
						} else {
							@components.ActionButton("stop", s.ID, false)
							@components.ActionButton("restart", s.ID, false)
						}
						<button
							type="button"
							hx-delete={ "/servers/" + s.ID }
							hx-target="#server-table-container"
							hx-swap="innerHTML"
							hx-confirm={ "Confirm decommissioning node " + s.Name + " (" + s.ID + ")?" }
							onclick="document.getElementById('detail-drawer').remove()"
							class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 transition-colors cursor-pointer"
							title="Decommission node"
						>
							<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M3 6h18"></path>
								<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
								<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
							</svg>
							<span>Decommission</span>
						</button>
					</div>
				</div>

				<!-- Telemetry Gauges (Responsive 2-col on mobile, 4-col on desktop) -->
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">Latency</span>
						<p class="text-base font-semibold text-cyan-400 font-mono mt-1">{ fmt.Sprintf("%.1fms", s.LatencyMS) }</p>
					</div>
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">SLA</span>
						<p class="text-base font-semibold text-emerald-400 font-mono mt-1">{ fmt.Sprintf("%.1f%%", s.UptimePct) }</p>
					</div>
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">CPU</span>
						<p class="text-base font-semibold text-zinc-100 font-mono mt-1">{ fmt.Sprintf("%.1f%%", s.CPUUsage) }</p>
					</div>
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">RAM</span>
						<p class="text-base font-semibold text-zinc-100 font-mono mt-1">{ fmt.Sprintf("%.1f%%", s.MemoryUsage) }</p>
					</div>
				</div>

				<!-- Node Metadata -->
				<div class="rounded-lg bg-zinc-950/40 border border-zinc-800 p-4 space-y-2.5 text-xs">
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Driver & Protocol</span>
						<div class="flex items-center gap-1.5">
							@components.DriverBadge(s.Driver)
							@components.ProtocolBadge(s.Protocol)
						</div>
					</div>
					if s.SSLExpiryDays >= 0 {
						<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
							<span class="text-zinc-500">TLS Peer Certificate</span>
							<div>
								@components.SSLBadge(s.SSLExpiryDays)
							</div>
						</div>
					}
					if s.EndpointURL != "" {
						<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
							<span class="text-zinc-500">Endpoint Target</span>
							if s.Driver == "http" {
								<a href={ templ.SafeURL(s.EndpointURL) } target="_blank" rel="noopener noreferrer" class="font-mono text-cyan-400 hover:underline truncate max-w-[200px] sm:max-w-[240px]">{ s.EndpointURL }</a>
							} else {
								<span class="font-mono text-amber-400 truncate max-w-[200px] sm:max-w-[240px]">{ s.EndpointURL }</span>
							}
						</div>
					}
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Node Identifier</span>
						<span class="font-mono text-zinc-300">{ s.ID }</span>
					</div>
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Network Host</span>
						<span class="font-mono text-zinc-300">{ s.IPAddress }</span>
					</div>
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Availability Zone</span>
						<span class="text-zinc-300">{ s.Region }</span>
					</div>
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Current Uptime</span>
						<span class="text-zinc-300">{ s.Uptime }</span>
					</div>
					<div class="flex items-center justify-between py-1">
						<span class="text-zinc-500">Registered</span>
						<span class="text-zinc-400">{ s.CreatedAt.Format("2006-01-02 15:04:05 UTC") }</span>
					</div>
				</div>

				<!-- Multi-Region Satellite Telemetry -->
				if len(s.RegionalProbes) > 0 {
					<div class="space-y-2">
						<div class="flex items-center justify-between">
							<h4 class="text-xs font-semibold text-zinc-300">Multi-Region Edge Consensus</h4>
							<span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-1.5 py-0.5 rounded">Consensus Active</span>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
							for _, rp := range s.RegionalProbes {
								<div class="p-2.5 rounded-lg bg-zinc-950/60 border border-zinc-800">
									<div class="flex items-center justify-between">
										<span class="text-[10px] uppercase font-mono text-zinc-400">{ rp.Region }</span>
										if rp.Status == "operational" {
											<span class="w-2 h-2 rounded-full bg-emerald-400" title="Operational"></span>
										} else if rp.Status == "degraded" {
											<span class="w-2 h-2 rounded-full bg-amber-400" title="Degraded"></span>
										} else {
											<span class="w-2 h-2 rounded-full bg-rose-500" title="Down"></span>
										}
									</div>
									<div class="mt-1 flex items-baseline justify-between">
										<span class="text-xs font-mono font-semibold text-zinc-200">{ fmt.Sprintf("%.1fms", rp.AvgLatency) }</span>
										<span class="text-[10px] font-mono text-zinc-500">{ fmt.Sprintf("%.0f%% SLA", rp.SuccessRate) }</span>
									</div>
								</div>
							}
						</div>
					</div>
				}

				<!-- Probe Health History (if available) -->
				if len(s.ProbePoints) > 0 {
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-zinc-300">Recent Probe History</h4>
						<div class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-[11px] space-y-1.5 max-h-36 overflow-y-auto">
							for _, pt := range s.ProbePoints {
								<div class="flex items-center justify-between py-0.5 border-b border-zinc-900 last:border-0">
									<div class="flex items-center gap-2">
										if pt.Success {
											<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
											<span class="text-emerald-400">HTTP { fmt.Sprint(pt.StatusCode) }</span>
										} else {
											<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
											<span class="text-rose-400">ERR ({ fmt.Sprint(pt.StatusCode) })</span>
										}
										<span class="text-zinc-500 text-[10px]">{ pt.CreatedAt.Format("15:04:05") }</span>
									</div>
									<span class="text-zinc-300">{ fmt.Sprintf("%.1fms", pt.LatencyMS) }</span>
								</div>
							}
						</div>
					</div>
				}

				<!-- Node-Specific Audit Logs -->
				<div class="space-y-2">
					<h4 class="text-xs font-semibold text-zinc-300">Node Audit Events</h4>
					<div class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-[11px] space-y-1.5 max-h-48 overflow-y-auto">
						if len(logs) == 0 {
							<div class="text-zinc-500 text-center py-4">No logged events for this node.</div>
						} else {
							for _, l := range logs {
								<div class="flex items-start gap-2 text-zinc-400">
									<span class="text-zinc-600 flex-shrink-0">{ l.CreatedAt.Format("15:04:05") }</span>
									<span class="text-zinc-300">{ l.Message }</span>
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}
