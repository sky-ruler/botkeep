package pages

import (
	"fmt"
	"strings"
	"botkeep/internal/models"
	"botkeep/views/components"
)

templ ServerDetailDrawer(s models.Server, logs []models.LogEntry, remediations []models.Remediation) {
	<div id="detail-drawer" class="fixed inset-0 z-50 overflow-hidden bg-zinc-950/70 backdrop-blur-sm flex justify-end transition-opacity duration-300">
		<!-- Backdrop click to close -->
		<div class="fixed inset-0" onclick="document.getElementById('detail-drawer').remove()"></div>

		<!-- Slide-over panel -->
		<div class="relative w-full sm:max-w-md md:max-w-lg bg-zinc-900 border-l border-zinc-800 shadow-2xl flex flex-col h-full z-10 overflow-y-auto">
			<!-- Header -->
			<div class="p-5 sm:p-6 border-b border-zinc-800 flex items-start justify-between bg-zinc-900/90 sticky top-0 z-20 backdrop-blur-md">
				<div class="flex items-center gap-3">
					<div class="w-10 h-10 rounded-xl bg-zinc-800 border border-zinc-700/80 flex items-center justify-center text-zinc-200 flex-shrink-0">
						if s.Driver == "tcp" {
							@components.IconDatabase("w-5 h-5 text-amber-400")
						} else if s.Driver == "http" {
							@components.IconGlobe("w-5 h-5 text-cyan-400")
						} else {
							@components.IconServer("w-5 h-5")
						}
					</div>
					<div>
						<div class="flex flex-wrap items-center gap-2">
							<h3 class="text-base font-semibold text-zinc-100 tracking-tight">{ s.Name }</h3>
							@components.ServerStatusBadge(s.Status)
						</div>
						<p class="text-xs text-zinc-500 font-mono mt-0.5">{ s.ID } • { s.IPAddress } • { s.Region }</p>
					</div>
				</div>

				<button
					type="button"
					onclick="document.getElementById('detail-drawer').remove()"
					class="p-1.5 text-zinc-400 hover:text-zinc-100 rounded-md hover:bg-zinc-800 transition-colors cursor-pointer"
					title="Close inspector"
				>
					<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>

			<!-- Body -->
			<div class="p-5 sm:p-6 space-y-6 flex-1">
				<!-- Action Triggers inside Drawer -->
				<div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-lg bg-zinc-950/60 border border-zinc-800">
					<span class="text-xs font-medium text-zinc-400">Node State Actions</span>
					<div class="flex flex-wrap items-center gap-2">
						if s.Status == "stopped" {
							@components.ActionButton("start", s.ID, false)
						} else {
							@components.ActionButton("stop", s.ID, false)
							@components.ActionButton("restart", s.ID, false)
						}
						<button
							type="button"
							hx-delete={ "/servers/" + s.ID }
							hx-target="#server-table-container"
							hx-swap="innerHTML"
							hx-confirm={ "Confirm decommissioning node " + s.Name + " (" + s.ID + ")?" }
							onclick="document.getElementById('detail-drawer').remove()"
							class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-medium bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 transition-colors cursor-pointer"
							title="Decommission node"
						>
							<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M3 6h18"></path>
								<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
								<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
							</svg>
							<span>Decommission</span>
						</button>
					</div>
				</div>

				<!-- Telemetry Gauges (Responsive 2-col on mobile, 4-col on desktop) -->
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">Latency</span>
						<p class="text-base font-semibold text-cyan-400 font-mono mt-1">{ fmt.Sprintf("%.1fms", s.LatencyMS) }</p>
					</div>
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">SLA</span>
						<p class="text-base font-semibold text-emerald-400 font-mono mt-1">{ fmt.Sprintf("%.1f%%", s.UptimePct) }</p>
					</div>
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">CPU</span>
						<p class="text-base font-semibold text-zinc-100 font-mono mt-1">{ fmt.Sprintf("%.1f%%", s.CPUUsage) }</p>
					</div>
					<div class="p-3 rounded-lg bg-zinc-950/40 border border-zinc-800">
						<span class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">RAM</span>
						<p class="text-base font-semibold text-zinc-100 font-mono mt-1">{ fmt.Sprintf("%.1f%%", s.MemoryUsage) }</p>
					</div>
				</div>

				<!-- Node Metadata -->
				<div class="rounded-lg bg-zinc-950/40 border border-zinc-800 p-4 space-y-2.5 text-xs">
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Driver & Protocol</span>
						<div class="flex items-center gap-1.5">
							@components.DriverBadge(s.Driver)
							@components.ProtocolBadge(s.Protocol)
						</div>
					</div>
					if s.SSLExpiryDays >= 0 {
						<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
							<span class="text-zinc-500">TLS Peer Certificate</span>
							<div>
								@components.SSLBadge(s.SSLExpiryDays)
							</div>
						</div>
					}
					if s.EndpointURL != "" {
						<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
							<span class="text-zinc-500">Endpoint Target</span>
							if s.Driver == "http" {
								<a href={ templ.SafeURL(s.EndpointURL) } target="_blank" rel="noopener noreferrer" class="font-mono text-cyan-400 hover:underline truncate max-w-[200px] sm:max-w-[240px]">{ s.EndpointURL }</a>
							} else {
								<span class="font-mono text-amber-400 truncate max-w-[200px] sm:max-w-[240px]">{ s.EndpointURL }</span>
							}
						</div>
					}
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Node Identifier</span>
						<span class="font-mono text-zinc-300">{ s.ID }</span>
					</div>
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Network Host</span>
						<span class="font-mono text-zinc-300">{ s.IPAddress }</span>
					</div>
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Availability Zone</span>
						<span class="text-zinc-300">{ s.Region }</span>
					</div>
					<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
						<span class="text-zinc-500">Current Uptime</span>
						<span class="text-zinc-300">{ s.Uptime }</span>
					</div>
					<div class="flex items-center justify-between py-1">
						<span class="text-zinc-500">Registered</span>
						<span class="text-zinc-400">{ s.CreatedAt.Format("2006-01-02 15:04:05 UTC") }</span>
					</div>
				</div>

				<!-- Multi-Region Satellite Telemetry -->
				if len(s.RegionalProbes) > 0 {
					<div class="space-y-2">
						<div class="flex items-center justify-between">
							<h4 class="text-xs font-semibold text-zinc-300">Multi-Region Edge Consensus</h4>
							<span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-1.5 py-0.5 rounded">Consensus Active</span>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
							for _, rp := range s.RegionalProbes {
								<div class="p-2.5 rounded-lg bg-zinc-950/60 border border-zinc-800">
									<div class="flex items-center justify-between">
										<span class="text-[10px] uppercase font-mono text-zinc-400">{ rp.Region }</span>
										if rp.Status == "operational" {
											<span class="w-2 h-2 rounded-full bg-emerald-400" title="Operational"></span>
										} else if rp.Status == "degraded" {
											<span class="w-2 h-2 rounded-full bg-amber-400" title="Degraded"></span>
										} else {
											<span class="w-2 h-2 rounded-full bg-rose-500" title="Down"></span>
										}
									</div>
									<div class="mt-1 flex items-baseline justify-between">
										<span class="text-xs font-mono font-semibold text-zinc-200">{ fmt.Sprintf("%.1fms", rp.AvgLatency) }</span>
										<span class="text-[10px] font-mono text-zinc-500">{ fmt.Sprintf("%.0f%% SLA", rp.SuccessRate) }</span>
									</div>
								</div>
							}
						</div>
					</div>
				}

				<!-- Multi-Protocol & Security Telemetry Cards -->
				if s.Driver == "grpc" || s.Protocol == "GRPC" || s.Protocol == "GRPCS" || s.GRPCService != "" {
					<div class="rounded-lg bg-zinc-950/60 border border-purple-900/40 p-4 space-y-2.5">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-purple-400"></span>
								<h4 class="text-xs font-semibold text-purple-200">gRPC Microservice Health Check</h4>
							</div>
							<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-purple-500/10 text-purple-400 border border-purple-500/20">grpc.health.v1</span>
						</div>
						<div class="space-y-1.5 text-xs">
							<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
								<span class="text-zinc-500">Service Contract</span>
								if s.GRPCService != "" {
									<span class="font-mono text-purple-300">{ s.GRPCService }</span>
								} else {
									<span class="font-mono text-zinc-400">Overall Health (Root Service)</span>
								}
							</div>
							<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
								<span class="text-zinc-500">Transport Framing</span>
								<span class="font-mono text-zinc-300">HTTP/2 Cleartext / TLS ALPN</span>
							</div>
							<div class="flex items-center justify-between py-1">
								<span class="text-zinc-500">Serving State</span>
								<span class="font-mono text-emerald-400 font-semibold">SERVING (0 OK)</span>
							</div>
						</div>
					</div>
				}

				if s.SSLExpiryDays >= 0 || s.SSLIssuer != "" {
					<div class="rounded-lg bg-zinc-950/60 border border-zinc-800 p-4 space-y-2.5">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
									<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
								</svg>
								<h4 class="text-xs font-semibold text-zinc-200">SSL/TLS Certificate Intelligence</h4>
							</div>
							if s.SSLExpiryDays > 30 {
								<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
									{ fmt.Sprintf("%d Days Remaining", s.SSLExpiryDays) }
								</span>
							} else if s.SSLExpiryDays >= 0 {
								<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">
									{ fmt.Sprintf("Expiring Soon (%dd)", s.SSLExpiryDays) }
								</span>
							} else {
								<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-rose-500/10 text-rose-400 border border-rose-500/20">Expired</span>
							}
						</div>
						<div class="space-y-1.5 text-xs">
							if s.SSLIssuer != "" {
								<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
									<span class="text-zinc-500">Issuer / CA</span>
									<span class="font-mono text-zinc-300 truncate max-w-[220px]" title={ s.SSLIssuer }>{ s.SSLIssuer }</span>
								</div>
							}
							if s.SSLValidTo != nil {
								<div class="flex items-center justify-between py-1 border-b border-zinc-800/60">
									<span class="text-zinc-500">Expiration Date</span>
									<span class="font-mono text-zinc-300">{ s.SSLValidTo.Format("2006-01-02 15:04 UTC") }</span>
								</div>
							}
							if s.SSLSANs != "" {
								<div class="py-1">
									<span class="text-zinc-500 block mb-1">Subject Alternative Names (SANs)</span>
									<div class="flex flex-wrap gap-1">
										for _, san := range strings.Split(s.SSLSANs, ",") {
											<span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-zinc-900 border border-zinc-800 text-zinc-300">
												{ strings.TrimSpace(san) }
											</span>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}

				if s.Driver == "dns" || s.DNSRecords != "" || s.DNSLatencyMS > 0 {
					<div class="rounded-lg bg-zinc-950/60 border border-sky-900/40 p-4 space-y-2.5">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<span class="w-2 h-2 rounded-full bg-sky-400"></span>
								<h4 class="text-xs font-semibold text-sky-200">DNS Resolution & Edge Routing</h4>
							</div>
							if s.DNSLatencyMS > 0 {
								<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-sky-500/10 text-sky-400 border border-sky-500/20">
									{ fmt.Sprintf("%.1fms lookup", s.DNSLatencyMS) }
								</span>
							}
						</div>
						if s.DNSRecords != "" {
							<div class="space-y-1 text-xs">
								<span class="text-zinc-500 text-[11px]">Resolved Records (A / AAAA):</span>
								<div class="flex flex-wrap gap-1 font-mono text-[11px]">
									for _, rec := range strings.Split(s.DNSRecords, ",") {
										<span class="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-sky-300">
											{ strings.TrimSpace(rec) }
										</span>
									}
								</div>
							</div>
						}
					</div>
				}

				if s.Driver == "http" {
					<!-- Synthetic Health Checks & Assertions -->
					<div class="rounded-lg bg-zinc-950/60 border border-cyan-900/40 p-4 space-y-3">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<circle cx="12" cy="12" r="10"></circle>
									<path d="m9 12 2 2 4-4"></path>
								</svg>
								<h4 class="text-xs font-semibold text-cyan-200">Synthetic Probing & Assertions</h4>
							</div>
							<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
								{ s.HTTPMethod } • { s.ExpectedStatus }
							</span>
						</div>
						<p class="text-[11px] text-zinc-400">Configure synthetic HTTP request parameters, custom headers, expected status codes, and body response keyword assertions.</p>

						<form
							hx-post={ "/servers/" + s.ID + "/synthetic" }
							hx-target="#detail-drawer"
							hx-swap="outerHTML"
							class="space-y-3"
						>
							<div class="grid grid-cols-2 gap-2">
								<div class="space-y-1">
									<label class="text-[11px] text-zinc-400 font-medium">HTTP Method</label>
									<select
										name="http_method"
										class="w-full px-2.5 py-1.5 bg-zinc-900 border border-zinc-800 rounded text-xs font-mono text-zinc-200 focus:outline-none focus:border-cyan-500"
									>
										if s.HTTPMethod == "POST" {
											<option value="GET">GET</option>
											<option value="POST" selected>POST</option>
											<option value="HEAD">HEAD</option>
										} else if s.HTTPMethod == "HEAD" {
											<option value="GET">GET</option>
											<option value="POST">POST</option>
											<option value="HEAD" selected>HEAD</option>
										} else {
											<option value="GET" selected>GET</option>
											<option value="POST">POST</option>
											<option value="HEAD">HEAD</option>
										}
									</select>
								</div>
								<div class="space-y-1">
									<label class="text-[11px] text-zinc-400 font-medium">Expected Status</label>
									<input
										type="text"
										name="expected_status"
										value={ s.ExpectedStatus }
										placeholder="200 or 2xx or 200,201"
										class="w-full px-2.5 py-1.5 bg-zinc-900 border border-zinc-800 rounded text-xs font-mono text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-cyan-500"
									/>
								</div>
							</div>

							<div class="space-y-1">
								<label class="text-[11px] text-zinc-400 font-medium">Body Keyword Assertion (optional)</label>
								<input
									type="text"
									name="body_assertion"
									value={ s.BodyAssertion }
									placeholder="e.g. healthy or {&quot;ok&quot;:true}"
									class="w-full px-3 py-1.5 bg-zinc-900 border border-zinc-800 rounded text-xs font-mono text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-cyan-500"
								/>
							</div>

							<div class="space-y-1">
								<label class="text-[11px] text-zinc-400 font-medium">Custom Request Headers (newline separated)</label>
								<textarea
									name="custom_headers"
									rows="2"
									placeholder="Authorization: Bearer token&#10;X-Probe-Source: botkeep"
									class="w-full px-3 py-1.5 bg-zinc-900 border border-zinc-800 rounded text-xs font-mono text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-cyan-500"
								>{ s.CustomHeaders }</textarea>
							</div>

							<div class="flex justify-end pt-1">
								<button
									type="submit"
									class="px-3 py-1 rounded text-xs font-medium bg-cyan-600 hover:bg-cyan-500 text-white transition-colors cursor-pointer shadow-sm"
								>
									Save Synthetic Rules
								</button>
							</div>
						</form>
					</div>
				}

				<!-- Active Self-Healing Runbook Section -->
				<div class="rounded-lg bg-zinc-950/60 border border-zinc-800 p-4 space-y-3">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
							</svg>
							<h4 class="text-xs font-semibold text-zinc-200">Active Self-Healing Runbook</h4>
						</div>
						if s.RunbookEnabled {
							<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Auto-Heal Active</span>
						} else {
							<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-zinc-800 text-zinc-400">Disabled</span>
						}
					</div>
					<p class="text-[11px] text-zinc-400">Autonomous webhook trigger on downtime (GitHub Action, Kubernetes pod rollout, or Docker restart) before human escalation.</p>

					<form
						hx-post={ "/servers/" + s.ID + "/runbook" }
						hx-target="#detail-drawer"
						hx-swap="outerHTML"
						class="space-y-3"
					>
						<div class="space-y-1">
							<label class="text-[11px] text-zinc-400 font-medium">Remediation Webhook URL</label>
							<input
								type="url"
								name="runbook_url"
								value={ s.RunbookURL }
								placeholder="https://api.github.com/... or https://cluster.internal/webhook"
								class="w-full px-3 py-1.5 bg-zinc-900 border border-zinc-800 rounded text-xs font-mono text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-emerald-500"
							/>
						</div>

						<div class="flex flex-wrap items-center justify-between gap-2 pt-1">
							<label class="flex items-center gap-2 cursor-pointer">
								<input
									type="checkbox"
									name="runbook_enabled"
									value="1"
									if s.RunbookEnabled {
										checked
									}
									class="rounded bg-zinc-800 border-zinc-700 text-emerald-500 focus:ring-0 focus:ring-offset-0 cursor-pointer"
								/>
								<span class="text-xs text-zinc-300">Enable Autonomous Remediation</span>
							</label>

							<div class="flex items-center gap-2">
								if s.RunbookEnabled && s.RunbookURL != "" {
									<button
										type="button"
										hx-post={ "/servers/" + s.ID + "/runbook/trigger" }
										hx-swap="none"
										class="px-2.5 py-1 rounded text-xs font-medium bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 transition-colors cursor-pointer"
										title="Test-fire remediation webhook"
									>
										Smoke Test
									</button>
								}
								<button
									type="submit"
									class="px-3 py-1 rounded text-xs font-medium bg-emerald-600 hover:bg-emerald-500 text-white transition-colors cursor-pointer shadow-sm"
								>
									Save Runbook
								</button>
							</div>
						</div>
					</form>

					if len(remediations) > 0 {
						<div class="pt-2 border-t border-zinc-800/80 space-y-1.5">
							<span class="text-[10px] uppercase font-mono tracking-wider text-zinc-500">Autonomous Remediation History</span>
							<div class="space-y-1.5 max-h-36 overflow-y-auto">
								for _, rem := range remediations {
									<div class="p-2 rounded bg-zinc-900/80 border border-zinc-800/80 text-[11px] font-mono">
										<div class="flex items-center justify-between">
											<span class="font-semibold text-zinc-200">{ rem.ActionName }</span>
											if rem.Status == "healed" {
												<span class="text-emerald-400 font-semibold">Self-Healed ✓</span>
											} else if rem.Status == "triggered" {
												<span class="text-sky-400">Triggered</span>
											} else {
												<span class="text-rose-400">Failed</span>
											}
										</div>
										<p class="text-zinc-400 text-[10px] mt-0.5 truncate">{ rem.OutputLog }</p>
										<div class="text-[10px] text-zinc-500 mt-0.5 flex justify-between">
											<span>{ rem.TriggerReason }</span>
											<span>{ rem.CreatedAt.Format("15:04:05") }</span>
										</div>
									</div>
								}
							</div>
						</div>
					}
				</div>

				<!-- Probe Health History (if available) -->
				if len(s.ProbePoints) > 0 {
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-zinc-300">Recent Probe History</h4>
						<div class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-[11px] space-y-1.5 max-h-36 overflow-y-auto">
							for _, pt := range s.ProbePoints {
								<div class="flex items-center justify-between py-0.5 border-b border-zinc-900 last:border-0">
									<div class="flex items-center gap-2">
										if pt.Success {
											<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
											<span class="text-emerald-400">HTTP { fmt.Sprint(pt.StatusCode) }</span>
										} else {
											<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
											<span class="text-rose-400">ERR ({ fmt.Sprint(pt.StatusCode) })</span>
										}
										<span class="text-zinc-500 text-[10px]">{ pt.CreatedAt.Format("15:04:05") }</span>
									</div>
									<span class="text-zinc-300">{ fmt.Sprintf("%.1fms", pt.LatencyMS) }</span>
								</div>
							}
						</div>
					</div>
				}

				<!-- Node-Specific Audit Logs -->
				<div class="space-y-2">
					<h4 class="text-xs font-semibold text-zinc-300">Node Audit Events</h4>
					<div class="p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-[11px] space-y-1.5 max-h-48 overflow-y-auto">
						if len(logs) == 0 {
							<div class="text-zinc-500 text-center py-4">No logged events for this node.</div>
						} else {
							for _, l := range logs {
								<div class="flex items-start gap-2 text-zinc-400">
									<span class="text-zinc-600 flex-shrink-0">{ l.CreatedAt.Format("15:04:05") }</span>
									<span class="text-zinc-300">{ l.Message }</span>
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}
